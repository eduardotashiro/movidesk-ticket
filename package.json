{
  "name": "ticket",
  "version": "1.0.0",
  "description": "Integração com Movidesk & Slack para abertura e gestão de tickets via reação de mensagens.",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "tunnel": "ngrok http 3000"
  },
  "keywords": [
    "slack",
    "movidesk"
  ],
  "author": "Eduardo Tashiro",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "@slack/bolt": "^5.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "figlet": "^1.11.3",
    "pg": "^8.22.0"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/figlet": "^1.7.0",
    "@types/node": "^26.1.1",
    "@types/pg": "^8.20.0",
    "ngrok": "^5.0.0-beta.2",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=18"
  }
}